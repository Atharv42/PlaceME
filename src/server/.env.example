# Copy this file to .env and fill in your real values.
# NEVER commit the .env file — it is in .gitignore.

# MongoDB Atlas connection string
# Get this from: Atlas → Cluster → Connect → Drivers
MongoDB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/placeme?retryWrites=true&w=majority

# JWT signing secret — use a long random string (run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Gmail credentials for password-reset emails
# EMAIL_PASS must be a Gmail App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

# Server port (Render sets this automatically; 3000 for local dev)
PORT=3000

# Full URL of this backend — used when constructing uploaded file URLs
API_URL=http://localhost:3000

# Full URL of the frontend — used in password-reset email links
# In production: set to your Vercel URL, e.g. https://placeme.vercel.app
CLIENT_URL=http://localhost:5173
